<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.0</Version>
		<OutputPath>bin\$(Configuration)\JustNU-$(AssemblyName)-$(version)\SPT_Runtime\user\mods\$(ProjectName)\JustNU-$(AssemblyName)\</OutputPath>
		<PreserveCompilationContext>false</PreserveCompilationContext>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<DebugType>none</DebugType>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="bundles\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include=".\bundles.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="db\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include=".\config.jsonc">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="SPTushonka.Common" Version="4.1.6" />
		<PackageReference Include="SPTushonka.DI" Version="4.1.6" />
		<PackageReference Include="SPTushonka.Reflection" Version="4.1.6" />
		<PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
		<PackageReference Include="WTT-ServerCommonLib" Version="3.0.6" />
	</ItemGroup>
	
</Project>
